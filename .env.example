# rsync target for deploy.sh
PI_HOST=pi@raspberrypi.local
# PI_DEST=~/gemma-pi

# llama.cpp llama-server (OpenAI-compatible API). Base URL must include /v1.
# PI_ASSISTANT_LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1
# PI_ASSISTANT_LLAMACPP_MODEL=gemma3-1b-it
# Deprecated aliases (same PI_ASSISTANT_ prefix): PI_ASSISTANT_OLLAMA_HOST, PI_ASSISTANT_OLLAMA_MODEL

# Web search (OpenAI-style tool web_search to llama-server). Requires network + tool-capable model/template.
# PI_ASSISTANT_WEB_SEARCH_ENABLED=true
# PI_ASSISTANT_WEB_SEARCH_PROVIDER=ddgs
# PI_ASSISTANT_BRAVE_API_KEY=
# PI_ASSISTANT_TAVILY_API_KEY=
# PI_ASSISTANT_WEB_SEARCH_MAX_RESULTS=5
# PI_ASSISTANT_WEB_SEARCH_MAX_CHARS=6000
# PI_ASSISTANT_WEB_SEARCH_TIMEOUT_SECONDS=15
# PI_ASSISTANT_WEB_SEARCH_MAX_TOOL_ROUNDS=3

# Prompts: folder of *.md merged into system message (lexicographic order)
# PI_ASSISTANT_PROMPT_DIR=/absolute/or/relative/path/to/prompts

# Optional: appended after merged prompt files
# PI_ASSISTANT_SYSTEM_PROMPT=Always greet the user as Pi.

# SQLite conversation store (default ~/.pi-assistant/memory.db)
# PI_ASSISTANT_MEMORY_DB_PATH=data/memory.db

# UI
# PI_ASSISTANT_FULLSCREEN=false

# Audio (sounddevice / PortAudio). Use index or name substring, e.g. pipewire on Raspberry Pi OS + PipeWire.
# PI_ASSISTANT_INPUT_DEVICE=pipewire
# PI_ASSISTANT_OUTPUT_DEVICE=pipewire
# Or integers from: python -c "import sounddevice as sd; print(sd.query_devices()); print(sd.default.device)"

# Brief spoken ack + “thinking” phrases while waiting on Whisper/LLM (default on)
# PI_ASSISTANT_VOICE_FILLERS_ENABLED=false

# Whisper / Piper (Pi defaults under $HOME)
# PI_ASSISTANT_WHISPER_CLI=/home/pi/whisper.cpp/build/bin/whisper-cli
# PI_ASSISTANT_WHISPER_MODEL=/home/pi/whisper.cpp/models/ggml-base.en.bin
# PI_ASSISTANT_PIPER_BIN=/home/pi/piper/piper
# PI_ASSISTANT_PIPER_VOICE=/home/pi/piper/piper/en_US-lessac-medium.onnx
